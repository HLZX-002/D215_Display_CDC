# ---- JD9365 DSI panel: DSI link parameters ----
# mode: DSI_MOD_VID_PULSE=0x01, EVENT=0x02, BURST=0x04, NO_EOT=0x20
config AIC_JD9365_DSI_MODE
    hex
    default 0x24 if AIC_SCREEN_VMAXC16_9_16     # BURST | NO_EOT
    default 0x24 if AIC_SCREEN_VMAX17_11_88
    default 0x24 if AIC_SCREEN_VMAXA52_5_2
    default 0x24 if AIC_SCREEN_VMAXC50_6
    default 0x24 if AIC_SCREEN_VMAXC56_7
    default 0x24 if AIC_SCREEN_VMAXC32_10_95
    default 0x04 if AIC_SCREEN_VMAXA27_7        # BURST
    default 0x04 if AIC_SCREEN_VMAXC55_5_99
    default 0x24 if AIC_SCREEN_VMAXC57_7
    default 0x04 if AIC_SCREEN_VMAXC59_14_5 || AIC_SCREEN_VMAXC54_12_6
    default 0x04 if AIC_SCREEN_VMAXC15_10_11
    default 0x02 if AIC_SCREEN_VMAXC30_6_67     # EVENT
    default 0x24 if AIC_SCREEN_VMAXC40_12_6
    default 0x24 if AIC_SCREEN_VMAXC49_15_6
    default 0x24 if AIC_SCREEN_VMAXA67_11_6    

