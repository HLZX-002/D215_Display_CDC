# ---- JD9365 DSI panel: GPIO pins ----
# MIPI (ST7703 style): reset/on/iovcc
# EDP (DSI->eDP bridge): lcd_on/reset/led_en/led_pwm
# VMAXC30: reset/lcd_on/avdd/fd
config AIC_JD9365_RESET_PIN
    string
    default "PE.6"  if AIC_SCREEN_VMAXC16_9_16 || AIC_SCREEN_VMAX17_11_88 || \
                        AIC_SCREEN_VMAXA52_5_2 || AIC_SCREEN_VMAXC50_6 || \
                        AIC_SCREEN_VMAXC56_7 || AIC_SCREEN_VMAXC32_10_95 || AIC_SCREEN_VMAXA27_7 || \
                        AIC_SCREEN_VMAXC55_5_99 || AIC_SCREEN_VMAXC57_7
    default "PE.14" if AIC_SCREEN_VMAXC59_14_5 || AIC_SCREEN_VMAXC54_12_6
    default "PE.11" if AIC_SCREEN_VMAXC15_10_11
    default "PD.6"  if AIC_SCREEN_VMAXC30_6_67
    default "PE.15" if AIC_SCREEN_VMAXC40_12_6 || AIC_SCREEN_VMAXC49_15_6 || AIC_SCREEN_VMAXA67_11_6
    default "NONE"

config AIC_JD9365_ON_PIN
    string
    default "PE.2"  if AIC_SCREEN_VMAXC16_9_16 || AIC_SCREEN_VMAX17_11_88 || \
                        AIC_SCREEN_VMAXA52_5_2 || AIC_SCREEN_VMAXC50_6 || \
                        AIC_SCREEN_VMAXC56_7 || AIC_SCREEN_VMAXC32_10_95 || AIC_SCREEN_VMAXA27_7 || \
                        AIC_SCREEN_VMAXC55_5_99 || AIC_SCREEN_VMAXC57_7
    default "PE.3"  if AIC_SCREEN_VMAXC59_14_5 || AIC_SCREEN_VMAXC54_12_6
    default "PE.15" if AIC_SCREEN_VMAXC15_10_11
    default "PE.15" if AIC_SCREEN_VMAXC30_6_67
    default "PE.9"  if AIC_SCREEN_VMAXC40_12_6 || AIC_SCREEN_VMAXC49_15_6 || AIC_SCREEN_VMAXA67_11_6
    default "NONE"
    default "NONE"

config AIC_JD9365_IOVCC_PIN
