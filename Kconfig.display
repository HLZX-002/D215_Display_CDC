#
# Display Parameter
#
# 多屏整合：通过终端(menuconfig)选择主板与屏型号，所有屏参/引脚
# 按宏联动到既有 SDK 配置链（display interface / panel / touch / LVDS）。
#
# 命名规范：主板 AIC_BOARD_<文件夹名>，屏 AIC_SCREEN_<文件夹名>
#   （点号转为下划线，如 VMAXC16_462x1920_9.16 -> AIC_SCREEN_VMAXC16_9_16）
#
# 联动机制说明（重要）：
#   - 对既有 choice（Display interface / Panel Drivers / CTP device /
#     LVDS mode / LVDS link / framebuffer rotation）采用"条件 default"，
#     select 对 choice 成员无效，见各原定义文件中的修改。
#   - 对非 choice 的 bool（AIC_USING_TOUCH、AIC_PANEL_CUSTOM_RESOLUTION）
#     在本文件屏选择处 select。
#   - 新符号（AIC_JD9365_* 派生参数）在本文件首定义并条件 default；
#     既有符号（PANEL_*、AIC_TOUCH_*）只能在原文件内加条件 default，
#     跨文件 default 不生效（kconfiglib first-match 按 source 顺序）。
#

menu "Display Parameter"

choice
    prompt "Select Board"
    default AIC_BOARD_SY_L06

    config AIC_BOARD_SY_L06
        bool "SY_L06"

    config AIC_BOARD_SY701_D2
        bool "SY701_D2"

    config AIC_BOARD_HL1409
        bool "HL1409"

    config AIC_BOARD_HL1102
        bool "HL1102"

    config AIC_BOARD_HL6067
        bool "HL6067"

    config AIC_BOARD_HL6011
        bool "HL6011"

    config AIC_BOARD_HL6126
        bool "HL6126"
endchoice

choice
    prompt "Select Screen"
    default AIC_SCREEN_VMAXC16_9_16

    # ---------- SY_L06 (MIPI) ----------
    config AIC_SCREEN_VMAXC16_9_16
        bool "VMAXC16 9.16inch 462x1920"
        depends on AIC_BOARD_SY_L06
        select AIC_USING_TOUCH

    config AIC_SCREEN_VMAX17_11_88
        bool "VMAX17 11.88inch 320x1600"
        depends on AIC_BOARD_SY_L06

    config AIC_SCREEN_VMAXA52_5_2
        bool "VMAXA52 5.2inch 720x1280"
        depends on AIC_BOARD_SY_L06

    config AIC_SCREEN_VMAXC50_6
        bool "VMAXC50 6inch 720x1440"
        depends on AIC_BOARD_SY_L06

    config AIC_SCREEN_VMAXC56_7
        bool "VMAXC56 7inch 1200x1920"
        depends on AIC_BOARD_SY_L06

    config AIC_SCREEN_VMAXC32_10_95
        bool "VMAXC32 10.95inch 1200x1920"
        depends on AIC_BOARD_SY_L06

    # ---------- SY701_D2 (MIPI) ----------
    config AIC_SCREEN_VMAXA27_7
        bool "VMAXA27 7inch 1024x600"
        depends on AIC_BOARD_SY701_D2
        select AIC_USING_TOUCH

    config AIC_SCREEN_VMAXC55_5_99
        bool "VMAXC55 5.99inch 540x1092"
        depends on AIC_BOARD_SY701_D2

    config AIC_SCREEN_VMAXC57_7
        bool "VMAXC57 7inch 800x1280"
        depends on AIC_BOARD_SY701_D2

    # ---------- HL1409 (MIPI) ----------
    config AIC_SCREEN_VMAXC59_14_5
        bool "VMAXC59 14.5inch 2560x720"
        depends on AIC_BOARD_HL1409
        select AIC_USING_TOUCH

    config AIC_SCREEN_VMAXC54_12_6
        bool "VMAXC54 12.6inch 2560x666"
        depends on AIC_BOARD_HL1409
        select AIC_USING_TOUCH

    # ---------- HL1102 (MIPI) ----------
    config AIC_SCREEN_VMAXC15_10_11
        bool "VMAXC15 10.11inch 480x1920"
        depends on AIC_BOARD_HL1102
        select AIC_USING_TOUCH

    # ---------- HL6067 (MIPI) ----------
    config AIC_SCREEN_VMAXC30_6_67
        bool "VMAXC30 6.67inch 1080x2400"
        depends on AIC_BOARD_HL6067
        select AIC_USING_TOUCH

    # ---------- HL6011 (EDP, DSI to eDP bridge) ----------
    config AIC_SCREEN_VMAXC40_12_6
        bool "VMAXC40 12.6inch 1920x515"
        depends on AIC_BOARD_HL6011

    config AIC_SCREEN_VMAXC49_15_6
        bool "VMAXC49 15.6inch 1920x1080"
        depends on AIC_BOARD_HL6011

    config AIC_SCREEN_VMAXA67_11_6
        bool "VMAXA67 11.6inch 1366x768"
        depends on AIC_BOARD_HL6011

    # ---------- HL6126 (LVDS) ----------
    config AIC_SCREEN_VMAXA44_19
        bool "VMAXA44 19inch 1920x360"
        depends on AIC_BOARD_HL6126
        select AIC_USING_TOUCH
        select AIC_PANEL_CUSTOM_RESOLUTION

    config AIC_SCREEN_VMAXA51_12_3
        bool "VMAXA51 12.3inch 1920x720"
        depends on AIC_BOARD_HL6126
        select AIC_USING_TOUCH
        select AIC_PANEL_CUSTOM_RESOLUTION

    config AIC_SCREEN_VMAXC63_12_6
        bool "VMAXC63 12.6inch 2560x666"
        depends on AIC_BOARD_HL6126
        select AIC_USING_TOUCH
        select AIC_PANEL_CUSTOM_RESOLUTION
endchoice

# =====================================================================
# Derived parameters (not shown in menu, auto computed from screen)
# =====================================================================

source "bsp/artinchip/drv/display/Kconfig.profiles"
source "bsp/artinchip/drv/display/Kconfig.orientation"

